# Zkopírujte do .env a doplňte jeden z klíčů. Bez klíče aplikace vrací ukázková data (SERP_PROVIDER=mock).
# SerpApi – https://serpapi.com (zdarma 100 dotazů/měsíc)
SERPAPI_KEY=
# nebo Serper.dev – https://serper.dev (zdarma 2 500 dotazů)
SERPER_API_KEY=
# Volitelně vynucení poskytovatele: serpapi | serper | mock
SERP_PROVIDER=
# Země a jazyk výsledků Google
SEARCH_GL=cz
SEARCH_HL=cs
